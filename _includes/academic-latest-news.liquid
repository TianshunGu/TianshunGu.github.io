{% assign latest = site.pages
  | where_exp: 'entry', 'entry.news_date != nil'
  | where: 'section', 'news'
  | where: 'lang', page.lang
  | sort: 'news_date'
  | last
%}
<p class="latest-news">
  {% if page.lang == 'zh' %}
    <a href="{{ '/zh/news/' | relative_url }}">
      最新动态
      {%- if latest %}：{{ latest.news_headline | default: latest.title | escape }}（{{ latest.news_date_label | escape }}）{% endif %}
    </a>
  {% else %}
    <a href="{{ '/news/' | relative_url }}">
      Latest News
      {%- if latest %}: {{ latest.news_headline | default: latest.title | escape }} ({{ latest.news_date_label | escape }}){% endif %}
    </a>
  {% endif %}
</p>
